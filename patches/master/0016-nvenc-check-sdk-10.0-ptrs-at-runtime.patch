From bb84d2f77319041631be6d132a5caa9115669e89 Mon Sep 17 00:00:00 2001
From: wang-bin <wbsecg1@gmail.com>
Date: Fri, 3 Jul 2020 14:09:54 +0800
Subject: [PATCH 16/35] nvenc: check sdk 10.0 ptrs at runtime

---
 libavcodec/nvenc.c | 1 +
 1 file changed, 1 insertion(+)

diff --git a/libavcodec/nvenc.c b/libavcodec/nvenc.c
index 53230a88b0..e12f3fbbe7 100644
--- a/libavcodec/nvenc.c
+++ b/libavcodec/nvenc.c
@@ -1737,6 +1737,7 @@ static av_cold int nvenc_setup_encoder(AVCodecContext *avctx)
     else if (ctx->flags & NVENC_LOWLATENCY)
         ctx->init_encode_params.tuningInfo = NV_ENC_TUNING_INFO_LOW_LATENCY;
 
+    if (p_nvenc->nvEncGetEncodePresetConfigEx)
     nv_status = p_nvenc->nvEncGetEncodePresetConfigEx(ctx->nvencoder,
         ctx->init_encode_params.encodeGUID,
         ctx->init_encode_params.presetGUID,
